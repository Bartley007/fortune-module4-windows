APP_NAME=fortune-module4
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# The default Windows setup uses SQLite so the service starts without Docker.
DATABASE_URL=sqlite:///./module4.db
AUTO_CREATE_TABLES=true

DEV_USER_ID=dev-user
REQUIRE_USER_HEADER=false

# Local deterministic fallback. Switch to sentence-transformers for GPU embeddings.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Local template fallback. Point this to vLLM, Ollama, or LM Studio for GPU generation.
LLM_PROVIDER=template
LLM_MODEL=Qwen3-8B-Instruct
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

CASE_SIMILARITY_THRESHOLD=0.60

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
